include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md

recursive-include src/werender *.py
recursive-include src/werender/dashboard *.html *.js *.css
recursive-include docs *.md
recursive-include docs/security *.md
recursive-include docs/api *.md

global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude .git*
global-exclude .DS_Store
global-exclude Thumbs.db